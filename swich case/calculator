#include <iostream>
#include <clocale>
#include <windows.h>
using namespace std;

int main() {
    setlocale(LC_ALL, "Russian");
    SetConsoleCP(1251); SetConsoleOutputCP(1251);

    double a, b;
    char op;
    cout << "Введите выражение (например, 10 / 2): ";
    cin >> a >> op >> b;

    switch (op) {
    case '+': cout << "Результат: " << a + b << "\n"; break;
    case '-': cout << "Результат: " << a - b << "\n"; break;
    case '*': cout << "Результат: " << a * b << "\n"; break;
    case '/':
        if (b != 0) cout << "Результат: " << a / b << "\n";
        else cout << "Ошибка: деление на ноль!\n";
        break;
    default: cout << "Ошибка: неизвестная операция\n"; break;
    }
    return 0;
}

#include <iostream>
#include <clocale>
#include <windows.h>
using namespace std;

int main() {
    setlocale(LC_ALL, "Russian");
    SetConsoleCP(1251); SetConsoleOutputCP(1251);

    int day;
    cout << "Введите номер дня недели (1-7): ";
    cin >> day;

    // Используем switch, if для выбора дня не используем
    switch (day) {
    case 1: cout << "Понедельник\n"; break;
    case 2: cout << "Вторник\n"; break;
    case 3: cout << "Среда\n"; break;
    case 4: cout << "Четверг\n"; break;
    case 5: cout << "Пятница\n"; break;
    case 6: cout << "Суббота\n"; break;
    case 7: cout << "Воскресенье\n"; break;
    default: cout << "Ошибка: число вне диапазона 1-7\n"; break;
    }
    return 0;
}

#include <iostream>
#include <clocale>
#include <windows.h>
using namespace std;

int main() {
    setlocale(LC_ALL, "Russian");
    SetConsoleCP(1251); SetConsoleOutputCP(1251);

    int choice;
    cout << "Меню:\n";
    cout << "1. Приветствие\n";
    cout << "2. Текущее время\n";
    cout << "3. Калькулятор\n";
    cout << "4. Выход\n";
    cout << "Ваш выбор: ";
    cin >> choice;

    switch (choice) {
    case 1:
        cout << "Приветствую тебя, пользователь!\n";
        break;
    case 2:
        cout << "[Заглушка] Текущее время: 12:00\n";
        break;
    case 3:
        cout << "[Заглушка] Калькулятор в разработке...\n";
        break;
    case 4:
        cout << "Выход из программы. До свидания!\n";
        return 0; // Завершаем программу
    default:
        cout << "Ошибка: такого пункта в меню нет\n";
        break;
    }
    return 0;
}

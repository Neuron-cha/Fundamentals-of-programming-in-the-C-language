#include <iostream>
#include <clocale>
#include <windows.h>
using namespace std;

int main() {
    setlocale(LC_ALL, "Russian");
    SetConsoleCP(1251); SetConsoleOutputCP(1251);

    int mask;
    cout << "Введите маску прав (0-15): ";
    cin >> mask;

    if (mask < 0 || mask > 15) {
        cout << "Ошибка: маска должна быть от 0 до 15\n";
        return 0;
    }

    cout << "Чтение (4): " << ((mask & 4) ? "Да" : "Нет") << "\n";
    cout << "Запись (2): " << ((mask & 2) ? "Да" : "Нет") << "\n";
    cout << "Исполнение (1): " << ((mask & 1) ? "Да" : "Нет") << "\n";
    cout << "Удаление (8): " << ((mask & 8) ? "Да" : "Нет") << "\n";

    return 0;
}

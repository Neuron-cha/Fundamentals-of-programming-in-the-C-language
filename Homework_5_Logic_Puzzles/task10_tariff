#include <iostream>
#include <clocale>
#include <windows.h>
using namespace std;

int main() {
    setlocale(LC_ALL, "Russian");
    SetConsoleCP(1251); SetConsoleOutputCP(1251);

    int mins, gb, sms;
    cout << "Введите потраченные минуты, ГБ и SMS: ";
    cin >> mins >> gb >> sms;

    // Тариф 1: 300 мин, 5 ГБ, 100 SMS. База 500р. Сверхлимит: 2р/мин, 100р/ГБ, 1р/SMS
    double t1 = 500 + (mins > 300 ? (mins - 300) * 2 : 0) + (gb > 5 ? (gb - 5) * 100 : 0) + (sms > 100 ? (sms - 100) * 1 : 0);

    // Тариф 2: 500 мин, 10 ГБ, 200 SMS. База 800р. Сверхлимит: 1.5р/мин, 80р/ГБ, 0.5р/SMS
    double t2 = 800 + (mins > 500 ? (mins - 500) * 1.5 : 0) + (gb > 10 ? (gb - 10) * 80 : 0) + (sms > 200 ? (sms - 200) * 0.5 : 0);

    // Тариф 3: Безлимит (условно), База 1200р.
    double t3 = 1200;

    cout << "Стоимость Т1: " << t1 << " руб.\n";
    cout << "Стоимость Т2: " << t2 << " руб.\n";
    cout << "Стоимость Т3: " << t3 << " руб.\n";

    if (t1 <= t2 && t1 <= t3) {
        cout << "Самый выгодный тариф: №1 (" << t1 << " руб.)\n";
    } else if (t2 <= t1 && t2 <= t3) {
        cout << "Самый выгодный тариф: №2 (" << t2 << " руб.)\n";
    } else {
        cout << "Самый выгодный тариф: №3 (" << t3 << " руб.)\n";
    }
    return 0;
}

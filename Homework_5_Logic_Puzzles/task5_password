#include <iostream>
#include <string>
#include <clocale>
#include <windows.h>
using namespace std;

int main() {
    setlocale(LC_ALL, "Russian");
    SetConsoleCP(1251); SetConsoleOutputCP(1251);

    string pwd;
    cout << "Введите пароль: ";
    cin >> pwd;

    bool length_ok = (pwd.length() >= 8 && pwd.length() <= 12);
    bool has_digit = (pwd.find_first_of("0123456789") != string::npos);
    bool has_upper = (pwd.find_first_of("ABCDEFGHIJKLMNOPQRSTUVWXYZ") != string::npos);
    bool has_lower = (pwd.find_first_of("abcdefghijklmnopqrstuvwxyz") != string::npos);

    if (length_ok && has_digit && has_upper && has_lower) {
        cout << "Пароль валидный\n";
    } else {
        cout << "Пароль НЕ валидный. Причины:\n";
        if (!length_ok) cout << "- Длина должна быть от 8 до 12 символов\n";
        if (!has_digit) cout << "- Отсутствует цифра\n";
        if (!has_upper) cout << "- Отсутствует заглавная буква\n";
        if (!has_lower) cout << "- Отсутствует строчная буква\n";
    }
    return 0;
}

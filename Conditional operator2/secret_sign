#include <iostream>
#include <clocale>
#include <windows.h>
using namespace std;

int main() {
    setlocale(LC_ALL, "Russian");
    SetConsoleCP(1251); SetConsoleOutputCP(1251);

    char ch;
    cout << "Введите символ: ";
    cin >> ch;

    // Сначала проверяем, является ли символ цифрой
    if (ch >= '0' && ch <= '9') {
        cout << "Цифра\n";
    }
    else {
        // Остальное проверяем через switch
        switch (ch) {
        case '+': case '-': case '*': case '/':
            cout << "Оператор\n"; break;
        case '(': case ')': case '[': case ']': case '{': case '}':
            cout << "Скобка\n"; break;
        default:
            cout << "Неизвестный символ\n"; break;
        }
    }
    return 0;
}

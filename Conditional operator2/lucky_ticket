#include <iostream>
#include <clocale>
#include <windows.h>
using namespace std;

int main() {
    setlocale(LC_ALL, "Russian");
    SetConsoleCP(1251); SetConsoleOutputCP(1251);

    int ticket;
    cout << "Введите 6-значный номер билета: ";
    cin >> ticket;

    if (ticket < 100000 || ticket > 999999) {
        cout << "Ошибка: нужно 6-значное число\n";
        return 0;
    }

    // Извлекаем цифры
    int d1 = (ticket / 100000) % 10;
    int d2 = (ticket / 10000) % 10;
    int d3 = (ticket / 1000) % 10;
    int d4 = (ticket / 100) % 10;
    int d5 = (ticket / 10) % 10;
    int d6 = ticket % 10;

    int sum1 = d1 + d2 + d3;
    int sum2 = d4 + d5 + d6;

    bool firstEvenSecondOdd = (sum1 % 2 == 0) && (sum2 % 2 != 0);
    bool firstOddSecondEven = (sum1 % 2 != 0) && (sum2 % 2 == 0);

    if (firstEvenSecondOdd || firstOddSecondEven) {
        cout << "Билет счастливый!\n";
    }
    else {
        cout << "Билет обычный.\n";
    }
    return 0;
}

#include <iostream>
#include <clocale>
#include <windows.h>
using namespace std;

int main() {
    setlocale(LC_ALL, "Russian");
    SetConsoleCP(1251); SetConsoleOutputCP(1251);

    double num1, num2;
    char op;

    cout << "Введите выражение (например, 5 + 3): ";
    cin >> num1 >> op >> num2;

    if (op == '+') {
        cout << "Результат: " << num1 + num2 << "\n";
    }
    else if (op == '-') {
        cout << "Результат: " << num1 - num2 << "\n";
    }
    else if (op == '*') {
        cout << "Результат: " << num1 * num2 << "\n";
    }
    else if (op == '/') {
        if (num2 != 0) {
            cout << "Результат: " << num1 / num2 << "\n";
        }
        else {
            cout << "Ошибка: деление на ноль!\n";
        }
    }
    else {
        cout << "Ошибка: неизвестная операция\n";
    }
    return 0;
}

#include <iostream>
#include <cmath> // Для sqrt()
#include <clocale>
#include <windows.h>
using namespace std;

int main() {
    setlocale(LC_ALL, "Russian");
    SetConsoleCP(1251); SetConsoleOutputCP(1251);

    double a, b, c;
    cout << "Введите a, b, c: ";
    cin >> a >> b >> c;

    if (a == 0) {
        cout << "Это не квадратное уравнение (a=0).\n";
        if (b != 0) cout << "Один корень (линейное): x = " << -c / b << "\n";
        else if (c == 0) cout << "Бесконечно много решений.\n";
        else cout << "Корней нет.\n";
    }
    else {
        double D = b * b - 4 * a * c;
        if (D > 0) {
            double x1 = (-b + sqrt(D)) / (2 * a);
            double x2 = (-b - sqrt(D)) / (2 * a);
            cout << "Два корня: x1 = " << x1 << ", x2 = " << x2 << "\n";
        }
        else if (D == 0) {
            double x = -b / (2 * a);
            cout << "Один корень: x = " << x << "\n";
        }
        else {
            cout << "Корней нет (D < 0)\n";
        }
    }
    return 0;
}

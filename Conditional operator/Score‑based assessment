#include <iostream>
#include <clocale>
#include <windows.h>
using namespace std;

int main() {
    setlocale(LC_ALL, "Russian");
    SetConsoleCP(1251); SetConsoleOutputCP(1251);

    int score;
    cout << "Введите баллы (0-100): ";
    cin >> score;

    if (score < 0 || score > 100) {
        cout << "Ошибка: баллы вне диапазона\n";
    }
    else if (score >= 90) {
        cout << "Отлично\n";
    }
    else if (score >= 75) {
        cout << "Хорошо\n";
    }
    else if (score >= 60) {
        cout << "Удовлетворительно\n";
    }
    else {
        cout << "Неудовлетворительно\n";
    }
    return 0;
}

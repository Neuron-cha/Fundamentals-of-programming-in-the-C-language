#include <iostream>
#include <clocale>
#include <windows.h>
using namespace std;

int main() {
    setlocale(LC_ALL, "Russian");
    SetConsoleCP(1251); SetConsoleOutputCP(1251);

    int a, b, c;
    cout << "Введите три числа: ";
    cin >> a >> b >> c;

    if (a >= b && a >= c) {
        cout << "Максимум: " << a << "\n";
    }
    else if (b >= a && b >= c) {
        cout << "Максимум: " << b << "\n";
    }
    else {
        cout << "Максимум: " << c << "\n";
    }
    return 0;
}
